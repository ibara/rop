#!/bin/sh

# This configure script written by Brian Callahan <bcallaha@monmouth.edu>
# and released into the Public Domain.

Makefile() {
cat << EOF > Makefile
# This Makefile automatically generated by configure.

BINDIR =	$bindir
MANDIR =	$mandir

DMD =		$dmd
DFLAGS =	$dflags

ROP =		main.d config.d
OBJS =		main.o config.o opt.o

all: opt

opt:
	\${DMD} \${DFLAGS} $oflag \${ROP} $static

install:
	install -c -s -m 755 opt \${DESTDIR}\${BINDIR}
	install -c -m 444 opt.1 \${DESTDIR}\${MANDIR}/man1

uninstall:
	rm -f \${BINDIR}/opt
	rm -f \${MANDIR}/man1/opt.1

timing:
	rm -f \$@ a.out
	\${DMD} \${DFLAGS} \$@.d $static
	@-mv -f a.out \$@
	./\$@.sh 1000

clean:
	rm -f opt \${OBJS} opt.core timing timing.o a.out

distclean: clean
	rm -f Makefile config.d
EOF
}

gitrev() {
  githash="$(git rev-parse --verify HEAD 2>/dev/null)"
  if [ -z $githash ] ; then
    githash="unknown"
  fi
}

config() {
cat << EOF > config.d
/+ This file automatically generated by configure.  +/

module opt.config;

@safe @nogc pure nothrow string target() {
    return "$target";
}

@safe @nogc pure nothrow string v() {
EOF
if [ "x$githash" = "xunknown" ] ; then
cat << EOF >> config.d
    return "opt version $version";
EOF
else
cat << EOF >> config.d
    return "opt version $version, git hash $githash";
EOF
fi
cat << EOF >> config.d
}
EOF
}

dflagscheck() {
cat << EOF > conftest.d
void main(){}
EOF
  "$dmd" "$1" -c conftest.d > /dev/null 2>&1
  status=$?
  rm -f conftest.o conftest.d
  if [ $status -eq 0 ] ; then
    return 1
  fi
  return 0
}

dmdcheck() {
  for compiler in "$DMD" gdc ldc2 dmd ; do
cat << EOF > conftest.d
void main(){}
EOF
  ($compiler --version | grep -q "LDC - the LLVM D compiler") > /dev/null 2>&1
  if [ $? -eq 0 ] ; then
    is="ldc"
  else
    ($compiler --version | grep -q "Free Software Foundation") > /dev/null 2>&1
    if [ $? -eq 0 ] ; then
      is="gdc"
    else
      is="dmd"
    fi
  fi
  case "$is" in
    "dmd"|"ldc")
      oflag="-of\$@"
      ;;
    "gdc")
      oflag="-o \$@"
      ;;
  esac
  if [ $specifieddflags -eq 0 ] ; then
    case "$is" in
      "dmd")
        flags="-O -inline"
        ;;
      "gdc")
        flags="-O2 -pipe -finline"
        ;;
      "ldc")
        flags="-O"
        ;;
    esac
  fi
  if [ "x$is" = "xgdc" ] ; then
    $compiler -o conftest conftest.d > /dev/null 2>&1
  else
    $compiler conftest.d > /dev/null 2>&1
  fi
  status=$?
  rm -f conftest conftest.o conftest.d
  if [ $status -eq 0 ] ; then
    dmd="$compiler"
    return 0
  fi
  done
  return 1
}

staticcheck() {
cat << EOF > conftest.d
void main(){}
EOF
  "$dmd" -o conftest conftest.d -static-libphobos -static-libgcc > /dev/null 2>&1
  status=$?
  rm -f conftest conftest.o conftest.d
  if [ $status -eq 0 ] ; then
    return 1
  else
    return 0
  fi
}

version="2.36"

# Option variables
if [ ! -z "$PREFIX" ] ; then
  prefix="$PREFIX"
else
  prefix="/usr/local"
fi

bindirset=0
mandirset=0
specifieddflags=0
bindir="$prefix/bin"
mandir="$prefix/share/man"

# Options
for opt
do
  case "$opt" in
    --target=*)
      target="${opt#*=}"
      arch="$(echo ${opt#*=} | awk -F - '{print $1}')"
      case "$arch" in
        x86_64|amd64|i[3456789]86)
          ;;
        *)
          echo "error: Target must be one of amd64 or i386"
          exit 1
          ;;
      esac
      ;;
    --prefix=*)
      prefix=${opt#*=}
      if [ $bindirset -eq 0 ] ; then
        bindir="$prefix/bin"
      fi
      if [ $mandirset -eq 0 ] ; then
        mandir="$prefix/share/man"
      fi
      ;;
    --bindir=*)
      bindir=${opt#*=}
      bindirset=1
      ;;
    --mandir=*)
      mandir=${opt#*=}
      mandirset=1
      ;;
    --dmd=*)
      DMD=${opt#*=}
      ;;
    --dflags=*)
      flags="${flags} ${opt#*=}"
      specifieddflags=1
      ;;
    --help|-h)
      echo "Usage: configure [options]"
      echo ""
      echo "Options:"
      printf "  --help or -h            "
      echo "Display this help message"
      printf "  --target=TARGET         "
      echo "Set target to TARGET [autodetect]"
      printf "  --prefix=PREFIX         "
      echo "Top level install directory is PREFIX [$prefix]"
      printf "  --bindir=BINDIR         "
      echo "Install executable to BINDIR [$bindir]"
      printf "  --mandir=MANDIR         "
      echo "Install manual pages to MANDIR [$mandir]"
      printf "  --dmd=DMD               "
      echo "Use specified D compiler [autodetect]"
      printf "  --dflags=DFLAGS         "
      echo "Use specified DFLAGS [autodetect]"
      exit 1
      ;;
    *)
      ;;
  esac
done

printf "checking for D compiler... "
dmdcheck
if [ $? -ne 0 ] ; then
  echo "not found"
  echo "error: Please install a D compiler and re-run configure"
  exit 1
else
  echo "$dmd"
fi

if [ "x$is" = "xgdc" ] ; then
  printf "checking if the compiler accepts -static-libphobos -static-libgcc... "
  staticcheck
  if [ $? -eq 1 ] ; then
    static="-static-libphobos -static-libgcc"
    echo "yes"
  else
    echo "no"
  fi
fi

for flag in $flags ; do
  printf "checking if the compiler accepts %s... " "$flag"
  dflagscheck "$flag"
  if [ $? -eq 1 ] ; then
    dflags="$dflags $flag"
    echo "yes"
  else
    echo "no"
  fi
done
dflags="${dflags## }"

printf "checking for target... "
if [ -z "$target" ] ; then
  uname_s="$(uname -s)"
  case "x$uname_s" in
    "xDarwin"|"xFreeBSD"|"xOpenBSD")
      target="$(cc -dumpmachine)"
      ;;
    *)
      target="$(gcc -dumpmachine)"
      ;;
  esac
  if [ -z "$target" ] ; then
    target="x86_64-elf"
  fi
  arch="$(echo $target | awk -F - '{print $1}')"
  case "$arch" in
    x86_64|amd64|i[3456789]86)
      ;;
    *)
      echo "error: Target must be one of amd64 or i386"
      exit 1
      ;;
  esac
fi
os="$(echo $target | awk -F - '{print $NF}')"
case "$os" in
  darwin*)
    format="Mach-O"
    ;;
  *)
    format="ELF"
    ;;
esac
echo "$target"

printf "checking for git hash... "
gitrev
echo "$githash"

printf "creating config.d... "
config
echo "done"

printf "creating Makefile... "
Makefile
echo "done"
